<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_capsule_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_battery_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80% · Melting"
            android:textColor="#F0F6FC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_theme_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WINTER HEARTH &amp; GLACIER"
            android:textColor="#A5F3FC"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/pb_glacier"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="80"
            android:progressTint="#38BDF8"
            android:progressBackgroundTint="#FF6B1A" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_glacier_sprite"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/glacier_80"
        android:contentDescription="Glacier Battery State" />
</LinearLayout>
